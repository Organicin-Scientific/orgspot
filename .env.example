# Copy to `.env.local` and adjust. Never commit real secrets.
#
# --- Runtime ---
# Vercel injects this in deployment; optional locally
# VERCEL_ENV=development
# `local` | `preview` | `production` — use `local` with emulators
APP_ENV=local
# Base URL for links and callbacks (https in production)
APP_URL=http://localhost:3000

# --- Firebase Admin (server) ---
# GCP/Firebase project id
FIREBASE_PROJECT_ID=demo-organicin
# Service account (leave unset with emulators). The private key is PEM with `\n` for newlines.
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GCS bucket for Firebase Storage (project-id.appspot.com by convention)
FIREBASE_STORAGE_BUCKET=demo-organicin.appspot.com
# When set, the app refuses other project ids (must equal FIREBASE_PROJECT_ID in production)
ALLOWED_FIREBASE_PROJECT_ID=demo-organicin

# Firestore / Auth / Storage emulators (local only — unset in production)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Session & auth ---
# `true` enforces MFA for admins. Production requires true.
AUTH_REQUIRE_MFA=false
SESSION_MAX_AGE_HOURS=8

# --- Email (Resend) ---
# Only enable real sending in production with valid API credentials.
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=re_xxxxxxxx_replace_in_production
RESEND_WEBHOOK_SECRET=whsec_replace_in_production
RESEND_MAX_REQUESTS_PER_SECOND=2
SENDER_EMAIL=updates@updates.example.com

# --- Cron / tokens ---
# Min 32 chars; rotate in production
CRON_SECRET=dev-only-cron-secret-change-me-0000000000
TOKEN_SIGNING_SECRET=dev-only-token-signing-secret-change-me-0000
# Signed PDF link lifetime
PDF_LINK_TTL_DAYS=30

# --- Firebase client (public, safe in the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key-replace
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-organicin.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-organicin
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Host:port for Auth emulator; empty when not using emulators
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Set to `true` to show a dev sign-in form when using emulators
NEXT_PUBLIC_AUTH_EMULATOR_LOGIN=true

# --- AI drafting (Vertex Gemini, optional) ---
# Fill template [Write: …] prompts from notes/PDF. Requires Vertex AI API + roles/aiplatform.user on the service account.
AI_DRAFT_ENABLED=false
# GEMINI_MODEL=gemini-3.8-flash
# VERTEX_GEMINI_LOCATION=global

# Production notes:
# - Set AUTH_REQUIRE_MFA=true.
# - Set EMAIL_SENDING_ENABLED=true only when Resend is configured; omit unset emulator host variables.
# - Use https APP_URL and matching ALLOWED_FIREBASE_PROJECT_ID / FIREBASE_PROJECT_ID.
